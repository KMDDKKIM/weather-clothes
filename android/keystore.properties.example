# 이 파일을 복사해서 keystore.properties 로 이름을 바꾸고, 비밀번호를 채워 넣으세요.
# keystore.properties 는 git에 올라가지 않아요. (이 example 파일만 올라감)
# 주의: 이 파일은 한글을 제대로 못 읽어요. 경로와 비밀번호는 영문·숫자·기호만 쓰세요.
storeFile=C:/Users/PC/app-keys/weather-clothes-upload.jks
storePassword=YOUR_KEY_PASSWORD
keyAlias=upload
keyPassword=YOUR_KEY_PASSWORD
